 "id": "2026-11-polinrider",
 "slug": "polinrider",
 "kind": "security",
 "title": "PolinRider-style supply-chain malware in 24 Solana project forks",
 "shortTitle": "Supply-chain loader in 24 Solana repos",
 "discoveredAt": "2026-11-15",
 "discoveredBy": "Sol.College automated security review",
 "severity": "critical",
 "summary": "While cleaning a malware report on two forks in the Blockchains organisation, Sol.College's automated review scanned the organisation's repositories and found the same injected JavaScript loader in 24 of them. The code hides after long runs of whitespace on the last line of config files (postcss, tailwind, eslint, babel, jest), in hidden VS Code tasks that run when the folder is opened, and in JavaScript disguised as font files. Running the project's dev/build/lint tooling, or opening it in an editor that allows automatic tasks, downloads and runs a remote second stage. The pattern matches the publicly reported PolinRider campaign.",
 "behaviour": [
  "Obfuscated loader appended after whitespace on the last line of build/lint config files, so it runs whenever the tooling loads the config.",
  "Hidden .vscode/tasks.json task with runOn: folderOpen (plus task.allowAutomaticTasks: true) that executes a disguised payload when the folder is opened.",
  "JavaScript payloads disguised as Font Awesome font files, decoy files, and .gitignore entries that hide the attacker's push scripts.",
  "The loader resolves its server from blockchain transaction data, then downloads and executes a second stage with full Node.js privileges (remote code execution; typically used to steal keys and tokens)."
 ],
 "method": "Read-only: repositories were cloned as bare git repos and every branch tree was scanned by content signatures. No code from any affected repository was installed or executed. Fixes are single, non-history-rewriting commits that remove only the injected content.",
 "ourForks": {
  "org": "Blockchains",
  "reposCleaned": 24,
  "branchesCleaned": 175,
  "rescanClean": true,
  "rescanAt": "2026-11-15",
  "historyRewritten": false,
  "securityIssues": "One security issue opened on each affected fork (issue #1)."
 },
